RewriteEngine On

# Canonicalize the homepage: /index.html always redirects to /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L,NC]

# Allow the main blog page to work without a file extension
RewriteRule ^blog/?$ blog.php [L]

# Redirect clean URLs (e.g. /blog/post-slug) to the single-post.php file
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([^/]+)/?$ single-post.php?post=$1 [L,QSA]

# Allow the About Us page to work without .html extension
RewriteRule ^about-us/?$ about-us.html [L]

# Allow the Commercial Fridge Repair landing page to work without .html extension
RewriteRule ^commercial-fridge-repair-blacktown/?$ commercial-fridge-repair-blacktown.html [L]

# Allow the Freezer Repair landing page to work without .html extension
RewriteRule ^freezer-repair-blacktown/?$ freezer-repair-blacktown.html [L]

# Allow the Residential Fridge Repair landing page to work without .html extension
RewriteRule ^residential-fridge-repair/?$ residential-fridge-repair.html [L]

# Allow the Fridge Not Cooling Repair landing page to work without .html extension
RewriteRule ^fridge-not-cooling-repair/?$ fridge-not-cooling-repair.html [L]

# Allow the Fridge Regas landing page to work without .html extension
RewriteRule ^fridge-regas/?$ fridge-regas.html [L]

# Allow the Mobile Fridge Repair landing page to work without .html extension
RewriteRule ^mobile-fridge-repair/?$ mobile-fridge-repair.html [L]

# Allow the Samsung Fridge Repair landing page to work without .html extension
RewriteRule ^samsung-fridge-repair/?$ samsung-fridge-repair.html [L]

# Allow the LG Fridge Repair landing page to work without .html extension
RewriteRule ^lg-fridge-repair/?$ lg-fridge-repair.html [L]

# Allow the Westinghouse Fridge Repair landing page to work without .html extension
RewriteRule ^westinghouse-fridge-repair/?$ westinghouse-fridge-repair.html [L]

# Allow the Coolroom Repair landing page to work without .html extension
RewriteRule ^coolroom-repair/?$ coolroom-repair.html [L]

# Allow the Ice Machine Repair landing page to work without .html extension
RewriteRule ^ice-machine-repair/?$ ice-machine-repair.html [L]

# Allow the Fisher & Paykel Fridge Repair landing page to work without .html extension
RewriteRule ^fisher-paykel-fridge-repair/?$ fisher-paykel-fridge-repair.html [L]

# Allow the Emergency Fridge Repair landing page to work without .html extension
RewriteRule ^emergency-fridge-repair/?$ emergency-fridge-repair.html [L]

# Redirect the old /about.html to the new About Us page
RewriteCond %{THE_REQUEST} \s/+about\.html[\s?] [NC]
RewriteRule ^about\.html$ /about-us/ [R=301,L,NC]
